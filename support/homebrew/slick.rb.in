# template: The Homebrew cask. scripts/render-cask.sh fills each name between at signs and drops
# template: these lines. Its values come from support/brand.env, the origin remote, the deployment
# template: target in scripts/lib/env.sh and dist/release.env. docs/RELEASING.md says how the cask
# template: reaches the tap.
# template:
# template: The zap list names what the app writes. Its own caches live inside the data folder.
# template: Sparkle keeps downloaded updates and its installer's work under ~/Library/Caches in a
# template: folder named after the bundle ID, and the update choices in the preferences file.
# template: Secrets stay in the login keychain, which zap cannot reach. Homebrew now deprecates the
# template: url's verified parameter, so there is none.
cask "@TOKEN@" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@REPO@/releases/download/v#{version}/@BRAND_NAME@-#{version}.zip"
  name "@BRAND_NAME@"
  desc "Keyboard launcher for apps, settings, clipboard history and more"
  homepage "https://slick.computer/"

  # Releases are not pre-releases, so GitHub's latest release is the newest version.
  livecheck do
    url :url
    strategy :github_latest
  end

  # The app updates itself with Sparkle, so brew upgrade leaves it alone unless told --greedy.
  auto_updates true
  @DEPENDS_ON_ARCH@
  depends_on macos: :@MACOS@

  app "@BRAND_NAME@.app"

  uninstall quit: "@BRAND_BUNDLE_ID@"

  zap trash: [
    "~/Library/Application Support/@BRAND_DATA_DIR@",
    "~/Library/Caches/@BRAND_BUNDLE_ID@",
    "~/Library/Preferences/@BRAND_BUNDLE_ID@.plist",
    "~/Library/Saved Application State/@BRAND_BUNDLE_ID@.savedState",
  ]
end
