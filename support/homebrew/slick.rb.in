# template: The Homebrew cask. scripts/render-cask.sh fills each name between at signs and drops
# template: these lines. Its values come from support/brand.env, the origin remote, the deployment
# template: target in scripts/lib/env.sh and dist/release.env. docs/RELEASING.md says how the cask
# template: reaches the tap.
# template:
# template: The zap list names what the app writes. Its caches live inside the data folder, and no
# template: code writes under ~/Library/Caches. Secrets stay in the login keychain, which zap cannot
# template: reach. Homebrew now deprecates the url's verified parameter, so there is none.
cask "@TOKEN@" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@REPO@/releases/download/v#{version}/@BRAND_NAME@-#{version}.zip"
  name "@BRAND_NAME@"
  desc "Keyboard launcher for apps, settings, clipboard history and more"
  homepage "https://slick.computer/"

  # Every release so far is a pre-release, and the default strategy skips those.
  livecheck do
    url :url
    regex(/^v?(\d+(?:\.\d+)+)$/i)
    strategy :github_releases do |json, regex|
      json.filter_map do |release|
        next if release["draft"]

        release["tag_name"]&.[](regex, 1)
      end
    end
  end

  @DEPENDS_ON_ARCH@
  depends_on macos: :@MACOS@

  app "@BRAND_NAME@.app"

  uninstall quit: "@BRAND_BUNDLE_ID@"

  zap trash: [
    "~/Library/Application Support/@BRAND_DATA_DIR@",
    "~/Library/Preferences/@BRAND_BUNDLE_ID@.plist",
    "~/Library/Saved Application State/@BRAND_BUNDLE_ID@.savedState",
  ]
end
