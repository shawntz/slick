<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. scripts/info-plist.sh replaces each name between at signs with its value, and adds
     SUFeedURL and SUPublicEDKey only for a release. SUEnableAutomaticChecks false means Sparkle
     never asks its own question and checks nothing until the person turns checks on, and
     SUScheduledCheckInterval is then one day. SUAllowsAutomaticUpdates false means Sparkle never
     offers to download and install updates on its own: an update downloads only when the person
     chooses to install it. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>@BRAND_NAME@</string>
	<key>CFBundleIdentifier</key>
	<string>@BRAND_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@BRAND_NAME@</string>
	<key>CFBundleDisplayName</key>
	<string>@BRAND_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD_NUMBER@</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>@BRAND_BUNDLE_ID@</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>@BRAND_URL_SCHEME@</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>@MIN_MACOS@</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>NSHumanReadableCopyright</key>
	<string>Open source under the MIT license.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>@BRAND_NAME@ sends Apple Events only when you run a command that needs one: to Finder to empty the Trash, to System Events to switch between light and dark appearance, and to the login window to log out, restart or shut down. Script commands you add may send their own.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>@BRAND_NAME@ shows your upcoming events and their meeting links, suggests a meeting that is about to start, and adds the events you create from the launcher.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>@BRAND_NAME@ shows your reminders, completes or deletes the ones you choose, and adds the ones you create from the launcher.</string>
	<key>NSContactsUsageDescription</key>
	<string>@BRAND_NAME@ reads your contacts on this Mac so you can find people and call, message or email them from the launcher.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>@BRAND_NAME@ indexes the names of the files on your Desktop, once you include it in File Search, so you can find and open them from the launcher.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>@BRAND_NAME@ indexes the names of the files in Documents, once you include it in File Search, so you can find and open them from the launcher.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>@BRAND_NAME@ indexes the names of the files in Downloads, once you include it in File Search, so you can find and open them from the launcher.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>@BRAND_NAME@ indexes the names of the files on removable drives, once you include them in File Search, so you can find and open them from the launcher.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>@BRAND_NAME@ indexes the names of the files on network volumes, once you include them in File Search, so you can find and open them from the launcher.</string>
	<key>NSFileProviderDomainUsageDescription</key>
	<string>@BRAND_NAME@ indexes the names of the files in iCloud Drive, once you include it in File Search, so you can find and open them from the launcher. It downloads nothing.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>@BRAND_NAME@ connects to a model server on your local network only when you set one up in AI settings and ask a question.</string>
</dict>
</plist>
