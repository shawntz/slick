# The product's identity, for make and the scripts. Packages/Kit/Sources/Kit/Brand.swift holds the
# same name, bundle id, data folder and URL scheme for code, and scripts/check-brand.sh fails when
# the two disagree or when one of those values is hard-coded anywhere else. Renaming the product
# means editing these two files and nothing more.
#
# Format: KEY=value, one per line, no quotes and no spaces. make includes this file directly and
# the scripts read it line by line.

# Product name: the app bundle (<name>.app), its executable and the name people see.
BRAND_NAME=Slick
# Bundle identifier. macOS keys permission grants to it, so changing it resets them.
BRAND_BUNDLE_ID=com.shawnschwartz.slick
# Folder name under ~/Library/Application Support.
BRAND_DATA_DIR=Slick
# URL scheme for deep links (<scheme>://...).
BRAND_URL_SCHEME=slick
# The GitHub repository's address. ProjectLinks.repository in Packages/App holds the same address
# for the About pane, and scripts/check-brand.sh fails when the two differ. Updates come from the
# appcast.xml of its latest release: <address>/releases/latest/download/appcast.xml.
BRAND_REPOSITORY=https://github.com/shawntz/slick
# The public half of the EdDSA key that signs updates, as base64 of its 32 bytes: the value Sparkle
# reads as SUPublicEDKey. scripts/info-plist.sh writes it into Info.plist when it is set. The private
# half stays in the owner's login keychain. make release refuses to start while this is empty, and
# docs/RELEASING.md, under Updates, says how to make the key.
BRAND_UPDATE_PUBLIC_KEY=qBhWiesljnV6fvm7psxDwDbHS0bTkDLUvNx19ZA8q6E=
