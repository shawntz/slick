{
  "name": "Picking a weaker result twice makes it first",
  "timeLimit": 30,
  "steps": [
    { "summon": true },
    { "type": "te" },
    { "expect": { "selection": "Text Editor", "rowsInclude": ["Text Editor", "Notes"] } },
    { "waitUntilIdle": 3 },
    { "app": { "select": "Notes" } },
    { "expect": { "selection": "Notes" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "app": { "launched": ["com.example.notes"] } },
    { "summon": true },
    { "expect": { "query": "", "page": "root", "visible": true } },
    { "type": "te" },
    { "expect": { "selection": "Text Editor" } },
    { "waitUntilIdle": 3 },
    { "app": { "select": "Notes" } },
    { "expect": { "selection": "Notes" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "app": { "launched": ["com.example.notes", "com.example.notes"] } },
    { "summon": true },
    { "expect": { "query": "", "page": "root", "visible": true } },
    { "type": "te" },
    { "expect": { "selection": "Notes" } },
    { "expect": { "rowsInclude": ["Text Editor"] } },
    { "capture": { "name": "learned", "key": true } },
    { "dismiss": true }
  ]
}
