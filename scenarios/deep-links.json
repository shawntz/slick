{
  "name": "Links open the launcher and never run a command without asking",
  "timeLimit": 30,
  "steps": [
    { "expect": { "visible": false } },
    { "app": { "link": "{scheme}://search?q=notes", "linkOutcome": "openedLauncher" } },
    { "expect": { "visible": true, "page": "root", "query": "notes", "selection": "Notes" } },
    { "dismiss": true },
    { "app": { "link": "{scheme}://commands/apps/running", "linkOutcome": "asked" } },
    { "waitUntilIdle": 2 },
    { "expect": { "visible": true, "page": "list", "title": "Open Link", "rows": ["Run Running Applications", "Always Allow", "Cancel"], "selection": "Run Running Applications" } },
    { "capture": { "name": "ask", "key": true } },
    { "press": "down" },
    { "press": "down" },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": { "page": "root" } },
    { "app": { "launched": [] } },
    { "app": { "link": "{scheme}://commands/apps/running", "linkOutcome": "asked" } },
    { "waitUntilIdle": 2 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": { "page": "list", "rows": ["Mail", "Notes"] } },
    { "dismiss": true },
    { "app": { "link": "{scheme}://commands/apps/running", "linkOutcome": "asked" } },
    { "waitUntilIdle": 2 },
    { "press": "down" },
    { "expect": { "selection": "Always Allow" } },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": { "page": "list", "rows": ["Mail", "Notes"] } },
    { "dismiss": true },
    { "app": { "link": "{scheme}://commands/apps/running", "linkOutcome": "ran" } },
    { "waitUntilIdle": 2 },
    { "expect": { "visible": true, "page": "list", "rows": ["Mail", "Notes"] } },
    { "app": { "link": "{scheme}://commands/apps/quit-all?force=1", "linkOutcome": "refused" } },
    { "app": { "link": "javascript://search?q=x", "linkOutcome": "refused" } },
    { "app": { "link": "{scheme}://search?q=%E2%80%AEevil", "linkOutcome": "refused" } },
    { "expect": { "page": "list", "rows": ["Mail", "Notes"] } },
    { "app": { "launched": [] } }
  ]
}
