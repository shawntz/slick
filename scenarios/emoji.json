{
  "name": "Emoji fill a grid and answer a colon in root search",
  "timeLimit": 30,
  "steps": [
    { "app": { "setSettings": { "app.general.resetToRootAfter": 0 } } },
    { "summon": true },
    { "type": "search emoji" },
    { "expect": { "selection": "Search Emoji and Symbols" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "page": "grid" } },
    { "type": "grinning" },
    { "waitUntilIdle": 2 },
    { "expect": { "rowsInclude": ["Grinning Face", "Grinning Cat"] } },
    { "press": "escape" },
    { "type": "star struck" },
    { "waitUntilIdle": 2 },
    { "expect": { "selection": "Star-Struck" } },
    { "capture": { "name": "grid", "key": true } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "visible": false } },
    { "app": { "pasteboardText": "🤩" } },
    { "summon": true },
    { "expect": { "page": "root", "query": "" } },
    { "type": ":thumbs" },
    { "expect": { "rows": ["Thumbs Up", "Thumbs Down", "Search Google for \":thumbs\"", "Search Wikipedia for \":thumbs\""], "selection": "Thumbs Up" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "visible": false } },
    { "app": { "pasteboardText": "👍" } }
  ]
}
