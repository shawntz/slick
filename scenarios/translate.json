{
  "name": "Translate answers in root search with the simulated engine, names a language to download, and its page has a language menu",
  "timeLimit": 40,
  "steps": [
    { "summon": true },
    { "type": "tr Bonjour" },
    { "app": { "waitForRow": "Good morning" } },
    { "expect": { "selection": "Good morning" } },
    { "app": { "selectedSubtitle": "French → English (United States)" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "visible": false } },
    { "app": { "hud": "Copied Translation", "pasteboardText": "Good morning" } },
    { "summon": true },
    { "type": "tr Bonjour" },
    { "app": { "waitForRow": "Good morning" } },
    { "press": "cmd+l" },
    { "waitUntilIdle": 2 },
    { "expect": { "visible": false, "largeType": "Good morning" } },
    { "summon": true },
    { "press": "escape" },
    { "type": "tr Bonjour to German" },
    { "app": { "waitForRow": "Download German to Translate" } },
    { "expect": { "selection": "Download German to Translate" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "app": { "opened": ["x-apple.systempreferences:com.apple.Localization-Settings.extension?translation"] } },
    { "summon": true },
    { "type": "translate" },
    { "waitUntilIdle": 3 },
    { "app": { "select": "Translate" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "page": "list", "title": "Translate" } },
    { "app": { "filter": "English (United States)" } },
    { "type": "Bonjour" },
    { "waitUntilIdle": 3 },
    { "app": { "waitForRow": "Good morning" } },
    { "expect": { "rows": ["Good morning"], "detailIncludes": "Good morning" } },
    { "press": "cmd+p" },
    { "press": "g" },
    { "press": "e" },
    { "press": "r" },
    { "press": "m" },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "app": { "filter": "German" } },
    { "app": { "waitForRow": "Download German to Translate" } },
    { "dismiss": true }
  ]
}
