{
  "name": "Quick capture saves a note from root search, Append to Note adds a line, and Search Notes finds the note by a word in its text",
  "timeLimit": 40,
  "steps": [
    { "summon": true },
    { "type": "note buy oat milk" },
    { "waitUntilIdle": 3 },
    { "expect": { "selection": "Create Note “buy oat milk”" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "visible": false } },
    { "app": { "hud": "Saved Note" } },
    { "summon": true },
    { "type": "append to note" },
    { "waitUntilIdle": 3 },
    { "app": { "select": "Append to Note" } },
    { "press": "tab" },
    { "type": "and fresh bread" },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "page": "list", "rows": ["buy oat milk"] } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "app": { "hud": "Appended to “buy oat milk”" } },
    { "summon": true },
    { "expect": { "query": "", "visible": true } },
    { "type": "search notes" },
    { "waitUntilIdle": 3 },
    { "app": { "select": "Search Notes" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "type": "bread" },
    { "waitUntilIdle": 3 },
    { "expect": { "page": "list", "title": "Search Notes", "rows": ["buy oat milk"], "selection": "buy oat milk" } },
    { "expect": { "detailIncludes": "and fresh bread" } },
    { "expect": { "detailIncludes": "buy oat milk" } },
    { "app": { "launched": [], "opened": [] } },
    { "dismiss": true }
  ]
}
