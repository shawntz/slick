{
  "name": "System commands ask before they act and report what they did",
  "timeLimit": 30,
  "steps": [
    { "summon": true },
    { "type": "reboot" },
    { "expect": { "selection": "Restart" } },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": { "card": "Restart Your Mac Now?" } },
    { "capture": { "name": "restart-asks", "key": true } },
    { "press": "escape" },
    { "expect": { "card": "", "visible": true } },
    { "press": "escape" },
    { "type": "set volume" },
    { "expect": { "selection": "Set Volume" } },
    { "press": "tab" },
    { "type": "40" },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "app": { "hud": "Volume 40%" } },
    { "summon": true },
    { "press": "escape" },
    { "type": "toggle dark mode" },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "app": { "hud": "Switched to Dark Mode", "launched": [], "opened": [] } }
  ]
}
