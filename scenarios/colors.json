{
  "name": "Pick Color copies the simulated pick into Color History, a typed color shows its conversions, and contrast answers with the ratio",
  "timeLimit": 40,
  "steps": [
    { "summon": true },
    { "type": "pick color" },
    { "waitUntilIdle": 3 },
    { "app": { "select": "Pick Color" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "visible": false } },
    { "app": { "hud": "Copied #663399", "pasteboardText": "#663399" } },
    { "summon": true },
    { "type": "color history" },
    { "waitUntilIdle": 3 },
    { "app": { "select": "Color History" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "page": "list", "title": "Color History", "rows": ["#663399"] } },
    { "press": "cmd+escape" },
    { "press": "escape" },
    { "type": "#1e90ff" },
    { "expect": { "selection": "#1E90FF" } },
    { "app": { "selectedSubtitle": "rgb(30 144 255)  ·  hsl(209.6 100% 55.9%)  ·  oklch(65.2% 0.1901 253.21)" } },
    { "press": "cmd+k" },
    { "expect": { "actions": ["Copy as Hex", "Paste as Hex", "Show in Large Type", "Copy as RGB", "Copy as HSL", "Copy as HSB", "Copy as HWB", "Copy as OKLCH", "Copy as SwiftUI", "Copy as AppKit", "Copy as CSS Variable", "Open Color History", "Add to Favorites", "Set Alias", "Set Hotkey", "Reset Ranking"] } },
    { "press": "cmd+k" },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "visible": false } },
    { "app": { "hud": "Copied #1E90FF", "pasteboardText": "#1E90FF" } },
    { "summon": true },
    { "type": "#1e90ff" },
    { "press": "cmd+l" },
    { "waitUntilIdle": 2 },
    { "expect": { "visible": false, "largeType": "#1E90FF" } },
    { "summon": true },
    { "press": "escape" },
    { "type": "contrast #767676 on white" },
    { "expect": { "selection": "4.54:1" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "app": { "pasteboardText": "4.54:1" } },
    { "app": { "launched": [], "opened": [] } }
  ]
}
