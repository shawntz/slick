{
  "name": "A feature switched off while its rows show leaves the screen at once",
  "timeLimit": 20,
  "steps": [
    { "summon": true },
    { "type": "running" },
    { "expect": { "rowsInclude": ["Running Applications"] } },
    { "app": { "setFeatures": { "apps": false }, "featuresActive": { "apps": false } } },
    { "waitUntilIdle": 2 },
    { "expect": { "rows": ["Search Google for \"running\"", "Search Wikipedia for \"running\""], "visible": true } },
    { "press": "escape" },
    { "type": "notes" },
    { "expect": { "selection": "Search Notes" } },
    { "app": { "setFeatures": { "apps": true }, "featuresActive": { "apps": true } } },
    { "waitUntilIdle": 3 },
    { "expect": { "selection": "Search Notes", "rowsInclude": ["Search Google for \"notes\""] } },
    { "press": "escape" },
    { "type": "notes" },
    { "expect": { "selection": "Notes" } },
    { "press": "escape" },
    { "type": "running applications" },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": { "page": "list", "rows": ["Mail", "Notes"] } },
    { "app": { "setFeatures": { "apps": false } } },
    { "waitUntilIdle": 2 },
    { "expect": { "page": "root", "visible": true } },
    { "app": { "setFeatures": { "quicklinks": false, "scripts": false } } },
    { "press": "escape" },
    { "type": "qwzxv" },
    { "waitUntilIdle": 2 },
    { "expect": { "rowCount": 0 } },
    { "capture": { "name": "nothing", "key": true } },
    { "app": { "setFeatures": { "apps": true, "quicklinks": true, "scripts": true } } },
    { "waitUntilIdle": 3 },
    { "dismiss": true }
  ]
}
