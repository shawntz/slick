{
  "name": "Spotlight and Glass draw root search, a pushed list, the action panel and a form",
  "timeLimit": 60,
  "steps": [
    { "app": {"setSettings": {"themeName": "Spotlight"}, "theme": "Spotlight"} },
    { "summon": true },
    { "expect": {"visible": true, "page": "root", "query": ""} },
    { "capture": {"name": "spotlight-root", "key": true} },
    { "type": "notes" },
    { "expect": {"selection": "Notes"} },
    { "capture": {"name": "spotlight-typed", "key": true} },
    { "press": "cmd+k" },
    { "expect": {"actions": ["Open", "Show in Finder", "Show Package Contents", "Hide", "Quit", "Restart", "Force Quit", "Copy Name", "Copy Bundle Identifier", "Copy Path", "Add to Favorites", "Set Alias", "Set Hotkey", "Reset Ranking"]} },
    { "capture": {"name": "spotlight-actions", "key": true} },
    { "type": "add to favorites" },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": {"visible": true, "query": "notes", "toast": "Added to Favorites"} },
    { "capture": {"name": "spotlight-toast", "key": true} },
    { "press": "escape" },
    { "expect": {"query": ""} },
    { "type": "running" },
    { "expect": {"selection": "Running Applications"} },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": {"page": "list", "title": "Running Applications", "rows": ["Mail", "Notes"], "selection": "Mail"} },
    { "capture": {"name": "spotlight-list", "key": true} },
    { "press": "escape" },
    { "expect": {"page": "root", "query": "running"} },
    { "press": "escape" },
    { "expect": {"query": ""} },
    { "type": "create snippet" },
    { "expect": {"selection": "Create Snippet"} },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": {"page": "form", "title": "Create Snippet", "fieldErrors": []} },
    { "capture": {"name": "spotlight-form", "key": true} },
    { "press": "cmd+escape" },
    { "expect": {"page": "root"} },
    { "press": "escape" },
    { "expect": {"query": ""} },
    { "dismiss": true },
    { "expect": {"visible": false} },
    { "app": {"setSettings": {"themeName": "Glass"}, "theme": "Glass"} },
    { "summon": true },
    { "expect": {"visible": true, "page": "root", "query": ""} },
    { "capture": {"name": "glass-root", "key": true} },
    { "type": "notes" },
    { "expect": {"selection": "Notes"} },
    { "capture": {"name": "glass-typed", "key": true} },
    { "press": "cmd+k" },
    { "expect": {"actions": ["Open", "Show in Finder", "Show Package Contents", "Hide", "Quit", "Restart", "Force Quit", "Copy Name", "Copy Bundle Identifier", "Copy Path", "Remove from Favorites", "Set Alias", "Set Hotkey", "Reset Ranking"]} },
    { "capture": {"name": "glass-actions", "key": true} },
    { "press": "cmd+k" },
    { "expect": {"visible": true, "query": "notes"} },
    { "press": "escape" },
    { "expect": {"query": ""} },
    { "type": "running" },
    { "expect": {"selection": "Running Applications"} },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": {"page": "list", "title": "Running Applications", "rows": ["Mail", "Notes"], "selection": "Mail"} },
    { "capture": {"name": "glass-list", "key": true} },
    { "press": "escape" },
    { "expect": {"page": "root", "query": "running"} },
    { "press": "escape" },
    { "expect": {"query": ""} },
    { "type": "create snippet" },
    { "expect": {"selection": "Create Snippet"} },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": {"page": "form", "title": "Create Snippet", "fieldErrors": []} },
    { "capture": {"name": "glass-form", "key": true} },
    { "press": "cmd+escape" },
    { "expect": {"page": "root"} },
    { "press": "escape" },
    { "expect": {"query": ""} },
    { "dismiss": true },
    { "expect": {"visible": false} },
    { "app": {"setSettings": {"themeName": "Standard"}, "theme": "Standard"} }
  ]
}
