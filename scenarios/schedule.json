    { "waitUntilIdle": 3 },
    { "expect": { "page": "list", "title": "My Schedule", "selection": "Design Review", "rowsInclude": ["Design Review", "Planning"] } },
    { "press": "cmd+k" },
    { "expect": { "actions": ["Join Meeting", "Open in Calendar", "Copy Details", "Copy Meeting Link"] } },
