{
  "name": "The list narrows as the query grows, and the selection glides between rows",
  "timeLimit": 110,
  "systemApps": true,
  "media": {
    "file": "clip-narrow-dark",
    "appearance": "dark",
    "caption": "Type “calc” to find Calculator.",
    "alt": "Slick in dark mode. Typing “ca” narrows the app list. Arrow keys move the selection, then typing “lc” selects Calculator.",
    "gifAlt": "Slick in dark mode. Typing “ca” narrows the app list. Arrow keys move the selection, then typing “lc” selects Calculator.",
    "posterAlt": "Slick in dark mode. The search “ca” with Image Capture selected in the results."
  },
  "steps": [
    {
      "app": {
        "setFeatures": {
          "contacts": false,
          "schedule": false,
          "bookmarks": false,
          "ai": false,
          "snippets": false,
          "scripts": false,
          "menu-items": false
        },
        "setSettings": {
          "visibleRows": 7,
          "app.general.resetToRootAfter": 0
        }
      }
    },
    {
      "summon": true
    },
    {
      "type": "mail"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Mail"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "calendar"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Calendar"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "music"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Music"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "query": "",
        "rowsInclude": [
          "Mail",
          "Calendar",
          "Music"
        ]
      }
    },
    {
      "record": {
        "name": "clip-narrow-dark",
        "appearance": "dark"
      }
    },
    {
      "wait": 0.2
    },
    {
      "type": "c"
    },
    {
      "wait": 0.5
    },
    {
      "type": "a"
    },
    {
      "wait": 0.5
    },
    {
      "press": "down"
    },
    {
      "press": "down"
    },
    {
      "press": "down"
    },
    {
      "wait": 0.35
    },
    {
      "press": "up"
    },
    {
      "wait": 0.5
    },
    {
      "type": "lc"
    },
    {
      "expect": {
        "selection": "Calculator"
      }
    },
    {
      "wait": 1.3
    },
    {
      "stopRecording": {
        "tail": 0.4,
        "poster": 3.6
      }
    }
  ]
}
