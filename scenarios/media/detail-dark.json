{
  "name": "A command pushes its list with a detail pane beside it",
  "timeLimit": 110,
  "systemApps": true,
  "media": {
    "file": "clip-detail-dark",
    "appearance": "dark",
    "caption": "Find something you copied and paste it again.",
    "alt": "Slick in dark mode. Clipboard history shows sample text, a link, a color and code. Selecting an item shows its contents and details.",
    "gifAlt": "Slick in dark mode. Clipboard history shows sample text, a link, a color and code. Selecting an item shows its contents and details.",
    "posterAlt": "Slick in dark mode. Clipboard history with four sample items and a preview of the selected note."
  },
  "steps": [
    {
      "app": {
        "setFeatures": {
          "contacts": false,
          "schedule": false,
          "bookmarks": false,
          "ai": false,
          "snippets": false,
          "scripts": false,
          "menu-items": false,
          "clipboard": true
        },
        "setSettings": {
          "visibleRows": 7,
          "app.general.resetToRootAfter": 0
        }
      }
    },
    {
      "app": {
        "featuresActive": {
          "clipboard": true
        }
      }
    },
    {
      "app": {
        "copyAsOtherApp": [
          "let greeting = \"Hello, world\"",
          "#8743FA",
          "https://example.com/handbook/keyboard-shortcuts",
          "Planning notes: ship the onboarding flow first, then polish the settings window."
        ]
      }
    },
    {
      "summon": true
    },
    {
      "type": "mail"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Mail"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "calendar"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Calendar"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "music"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Music"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "query": "",
        "rowsInclude": [
          "Mail",
          "Calendar",
          "Music"
        ]
      }
    },
    {
      "record": {
        "name": "clip-detail-dark",
        "appearance": "dark"
      }
    },
    {
      "wait": 0.2
    },
    {
      "type": "clip"
    },
    {
      "expect": {
        "selection": "Clipboard History"
      }
    },
    {
      "wait": 0.5
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "page": "list",
        "title": "Clipboard History"
      }
    },
    {
      "wait": 0.9
    },
    {
      "press": "down"
    },
    {
      "wait": 0.6
    },
    {
      "press": "down"
    },
    {
      "wait": 0.6
    },
    {
      "press": "down"
    },
    {
      "wait": 0.8
    },
    {
      "type": "hand"
    },
    {
      "waitUntilIdle": 2
    },
    {
      "expect": {
        "rows": [
          "https://example.com/handbook/keyboard-shortcuts"
        ]
      }
    },
    {
      "wait": 1.2
    },
    {
      "stopRecording": {
        "tail": 0.4,
        "poster": 3.2
      }
    }
  ]
}
