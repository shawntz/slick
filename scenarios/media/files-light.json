{
  "name": "File search lists matching files beside a detail pane",
  "timeLimit": 110,
  "systemApps": true,
  "media": {
    "file": "clip-files-light",
    "appearance": "light",
    "caption": "Search files by name and see their details.",
    "alt": "Slick in light mode. Searching a sample file index for “budget” shows matching files and their type, size, date and folder.",
    "gifAlt": "Slick in light mode. Searching a sample file index for “budget” shows matching files and their type, size, date and folder.",
    "posterAlt": "Slick in light mode. Sample files matching “budget”, with details for the selected file."
  },
  "steps": [
    {
      "app": {
        "setFeatures": {
          "contacts": false,
          "schedule": false,
          "bookmarks": false,
          "ai": false,
          "snippets": false,
          "scripts": false,
          "menu-items": false,
          "files": true
        },
        "setSettings": {
          "visibleRows": 7,
          "app.general.resetToRootAfter": 0
        }
      }
    },
    {
      "app": {
        "featuresActive": {
          "files": true
        }
      }
    },
    {
      "summon": true
    },
    {
      "type": "mail"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Mail"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "calendar"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Calendar"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "music"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Music"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "query": "",
        "rowsInclude": [
          "Mail",
          "Calendar",
          "Music"
        ]
      }
    },
    {
      "record": {
        "name": "clip-files-light",
        "appearance": "light"
      }
    },
    {
      "wait": 0.2
    },
    {
      "type": "files"
    },
    {
      "expect": {
        "selection": "Search Files"
      }
    },
    {
      "wait": 0.5
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "page": "list",
        "title": "Search Files"
      }
    },
    {
      "wait": 0.5
    },
    {
      "type": "budget"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "selection": "budget8636.html"
      }
    },
    {
      "wait": 1.1
    },
    {
      "press": "down"
    },
    {
      "wait": 1.0
    },
    {
      "press": "down"
    },
    {
      "wait": 1.0
    },
    {
      "stopRecording": {
        "tail": 0.3,
        "poster": 4.2
      }
    }
  ]
}
