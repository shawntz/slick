{
  "name": "Spotlight theme, light mode, from opening the panel to picking an app",
  "timeLimit": 110,
  "systemApps": true,
  "media": {
    "file": "clip-spotlight-light",
    "appearance": "light",
    "caption": "A separate search field above the results.",
    "alt": "Slick in light mode. The Spotlight theme shows a search field above a separate results panel. Typing “cal” finds Calendar and Calculator. Command-K opens actions.",
    "gifAlt": "Slick in light mode. The Spotlight theme shows a search field above a separate results panel. Typing “cal” finds Calendar and Calculator. Command-K opens actions.",
    "posterAlt": "Slick in light mode. The Spotlight theme with “cal” in the search field and Calculator selected below.",
    "stills": [
      {
        "capture": "spotlight-light",
        "file": "spotlight-light.png",
        "caption": "The Spotlight theme in light mode, with the query in its capsule and the results in their own glass below.",
        "alt": "Slick's search panel in the Spotlight theme, light mode, over a pale lavender wallpaper. A tall capsule of glass holds the query “cal”, completed to “calendar” in grey. Below it, apart from it, a rounded container lists Calendar, Calculator, Calculator History, Quit All Applications and Eject All Disks, with Calculator selected. Apps show their own icons and commands show line glyphs. Command-1 to Command-5 sit at the right of the rows. Captured from the assembled app running a scripted scenario, with Apple's own apps."
      }
    ]
  },
  "steps": [
    {
      "app": {
        "setFeatures": {
          "contacts": false,
          "schedule": false,
          "bookmarks": false,
          "ai": false,
          "snippets": false,
          "scripts": false,
          "menu-items": false
        },
        "setSettings": {
          "visibleRows": 5,
          "app.general.resetToRootAfter": 0,
          "themeName": "Spotlight",
          "panelSizing": "fitContent"
        }
      }
    },
    {
      "app": {
        "theme": "Spotlight"
      }
    },
    {
      "summon": true
    },
    {
      "type": "mail"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Mail"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "calendar"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Calendar"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "music"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Music"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "notes"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Notes"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "record": {
        "name": "clip-spotlight-light",
        "appearance": "light",
        "lead": 0.3
      }
    },
    {
      "app": {
        "setSettings": {
          "visibleRows": 6
        }
      }
    },
    {
      "app": {
        "setSettings": {
          "visibleRows": 5
        }
      }
    },
    {
      "summon": true
    },
    {
      "waitUntilIdle": 2
    },
    {
      "expect": {
        "query": "",
        "rowsInclude": [
          "Mail",
          "Calendar",
          "Music",
          "Notes"
        ]
      }
    },
    {
      "wait": 0.4
    },
    {
      "wait": 0.3
    },
    {
      "type": "c"
    },
    {
      "wait": 0.3
    },
    {
      "type": "a"
    },
    {
      "wait": 0.3
    },
    {
      "type": "l"
    },
    {
      "waitUntilIdle": 2
    },
    {
      "expect": {
        "selection": "Calendar"
      }
    },
    {
      "wait": 0.6
    },
    {
      "app": {
        "select": "Calculator"
      }
    },
    {
      "expect": {
        "selection": "Calculator"
      }
    },
    {
      "wait": 0.5
    },
    {
      "still": "spotlight-light"
    },
    {
      "press": "cmd+k"
    },
    {
      "waitUntilIdle": 2
    },
    {
      "expect": {
        "actions": [
          "Open",
          "Show in Finder",
          "Show Package Contents",
          "Copy Name",
          "Copy Bundle Identifier",
          "Copy Path",
          "Add to Favorites",
          "Set Alias",
          "Set Hotkey",
          "Reset Ranking"
        ]
      }
    },
    {
      "wait": 0.8
    },
    {
      "press": "cmd+k"
    },
    {
      "waitUntilIdle": 2
    },
    {
      "expect": {
        "visible": true,
        "query": "cal",
        "selection": "Calculator"
      }
    },
    {
      "wait": 0.3
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "wait": 0.2
    },
    {
      "stopRecording": {
        "tail": 0.5,
        "poster": 5.1
      }
    },
    {
      "app": {
        "launched": [
          "com.apple.mail",
          "com.apple.iCal",
          "com.apple.Music",
          "com.apple.Notes",
          "com.apple.calculator"
        ]
      }
    }
  ]
}
