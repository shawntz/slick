{
  "name": "Picking the second result twice makes it first",
  "timeLimit": 110,
  "systemApps": true,
  "media": {
    "file": "clip-learn-light",
    "appearance": "light",
    "caption": "Pick Font Book twice for “bo” and it moves above Books.",
    "alt": "Slick in light mode. Font Book is selected twice for “bo”. On the next search it appears above Books.",
    "gifAlt": "Slick in light mode. Font Book is selected twice for “bo”. On the next search it appears above Books.",
    "posterAlt": "Slick in light mode. Font Book appears above Books for the search “bo”."
  },
  "steps": [
    {
      "app": {
        "setFeatures": {
          "contacts": false,
          "schedule": false,
          "bookmarks": false,
          "ai": false,
          "snippets": false,
          "scripts": false,
          "menu-items": false
        },
        "setSettings": {
          "visibleRows": 7,
          "app.general.resetToRootAfter": 0
        }
      }
    },
    {
      "record": {
        "name": "clip-learn-light",
        "appearance": "light",
        "pace": 0.85,
        "lead": 0.2
      }
    },
    {
      "summon": true
    },
    {
      "expect": {
        "query": ""
      }
    },
    {
      "type": "bo"
    },
    {
      "expect": {
        "selection": "Books"
      }
    },
    {
      "wait": 0.3
    },
    {
      "app": {
        "select": "Font Book"
      }
    },
    {
      "expect": {
        "selection": "Font Book"
      }
    },
    {
      "wait": 0.2
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "expect": {
        "query": ""
      }
    },
    {
      "type": "bo"
    },
    {
      "expect": {
        "selection": "Books"
      }
    },
    {
      "wait": 0.3
    },
    {
      "app": {
        "select": "Font Book"
      }
    },
    {
      "expect": {
        "selection": "Font Book"
      }
    },
    {
      "wait": 0.2
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "bo"
    },
    {
      "expect": {
        "selection": "Font Book",
        "rowsInclude": [
          "Books"
        ]
      }
    },
    {
      "wait": 1.5
    },
    {
      "stopRecording": {
        "tail": 0.3
      }
    }
  ]
}
