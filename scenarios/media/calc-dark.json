{
  "name": "The calculator answers as the query is typed",
  "timeLimit": 110,
  "systemApps": true,
  "media": {
    "file": "clip-calc-dark",
    "appearance": "dark",
    "caption": "Calculate as you type. Press Return to copy the answer.",
    "alt": "Slick in dark mode. The calculator solves 1250 × 1.08 as 1,350 and converts 5 kilometers to 3.10686 miles.",
    "gifAlt": "Slick in dark mode. The calculator solves 1250 × 1.08 as 1,350 and converts 5 kilometers to 3.10686 miles.",
    "posterAlt": "Slick in dark mode. The calculator shows 1,350 for the expression 1250 × 1.08."
  },
  "steps": [
    {
      "app": {
        "setFeatures": {
          "contacts": false,
          "schedule": false,
          "bookmarks": false,
          "ai": false,
          "snippets": false,
          "scripts": false,
          "menu-items": false
        },
        "setSettings": {
          "visibleRows": 7,
          "app.general.resetToRootAfter": 0
        }
      }
    },
    {
      "summon": true
    },
    {
      "type": "mail"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Mail"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "calendar"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Calendar"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "music"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Music"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "query": "",
        "rowsInclude": [
          "Mail",
          "Calendar",
          "Music"
        ]
      }
    },
    {
      "record": {
        "name": "clip-calc-dark",
        "appearance": "dark"
      }
    },
    {
      "wait": 0.2
    },
    {
      "type": "1250 * 1.08"
    },
    {
      "expect": {
        "selection": "1,350"
      }
    },
    {
      "wait": 1.4
    },
    {
      "press": "escape"
    },
    {
      "expect": {
        "query": ""
      }
    },
    {
      "wait": 0.4
    },
    {
      "type": "5 km in mi"
    },
    {
      "expect": {
        "selection": "3.10686 mi"
      }
    },
    {
      "wait": 1.4
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "wait": 0.3
    },
    {
      "stopRecording": {
        "tail": 0.4,
        "poster": 2.6
      }
    },
    {
      "app": {
        "pasteboardText": "3.10686 mi"
      }
    }
  ]
}
