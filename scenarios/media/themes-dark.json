{
  "name": "Switching themes restyles the open panel at once",
  "timeLimit": 110,
  "systemApps": true,
  "media": {
    "file": "clip-themes-dark",
    "appearance": "dark",
    "caption": "Change themes in Settings under Appearance.",
    "alt": "Slick in dark mode. The panel switches through Standard, Graphite, Ocean, Ember and Violet, changing its glass and selection colors.",
    "gifAlt": "Slick in dark mode. The panel switches through Standard, Graphite, Ocean, Ember and Violet, changing its glass and selection colors.",
    "posterAlt": "Slick in dark mode. The Ocean theme with blue glass and Calculator selected."
  },
  "steps": [
    {
      "app": {
        "setFeatures": {
          "contacts": false,
          "schedule": false,
          "bookmarks": false,
          "ai": false,
          "snippets": false,
          "scripts": false,
          "menu-items": false
        },
        "setSettings": {
          "visibleRows": 7,
          "app.general.resetToRootAfter": 0
        }
      }
    },
    {
      "summon": true
    },
    {
      "type": "mail"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Mail"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "calendar"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Calendar"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "music"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Music"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "query": "",
        "rowsInclude": [
          "Mail",
          "Calendar",
          "Music"
        ]
      }
    },
    {
      "record": {
        "name": "clip-themes-dark",
        "appearance": "dark"
      }
    },
    {
      "wait": 0.2
    },
    {
      "type": "ca"
    },
    {
      "wait": 0.7
    },
    {
      "app": {
        "setSettings": {
          "themeName": "Graphite"
        },
        "theme": "Graphite"
      }
    },
    {
      "wait": 0.25
    },
    {
      "press": "down"
    },
    {
      "wait": 0.7
    },
    {
      "app": {
        "setSettings": {
          "themeName": "Ocean"
        },
        "theme": "Ocean"
      }
    },
    {
      "wait": 0.25
    },
    {
      "press": "down"
    },
    {
      "wait": 0.7
    },
    {
      "app": {
        "setSettings": {
          "themeName": "Ember"
        },
        "theme": "Ember"
      }
    },
    {
      "wait": 0.25
    },
    {
      "press": "down"
    },
    {
      "wait": 0.7
    },
    {
      "app": {
        "setSettings": {
          "themeName": "Violet"
        },
        "theme": "Violet"
      }
    },
    {
      "wait": 0.25
    },
    {
      "press": "down"
    },
    {
      "wait": 0.7
    },
    {
      "app": {
        "setSettings": {
          "themeName": "Standard"
        },
        "theme": "Standard"
      }
    },
    {
      "wait": 0.25
    },
    {
      "press": "down"
    },
    {
      "wait": 0.7
    },
    {
      "stopRecording": {
        "tail": 0.2,
        "poster": 3.7
      }
    }
  ]
}
