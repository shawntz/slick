{
  "name": "Glass theme, light mode, over a window, from opening the panel to picking an app",
  "timeLimit": 110,
  "systemApps": true,
  "media": {
    "file": "clip-glass-light",
    "appearance": "light",
    "caption": "Clear glass keeps the window behind Slick visible.",
    "alt": "Slick in light mode. The Glass theme shows Calculator selected for “cal”. Slick’s settings window remains visible through the panel.",
    "gifAlt": "Slick in light mode. The Glass theme shows Calculator selected for “cal”. Slick’s settings window remains visible through the panel.",
    "posterAlt": "Slick in light mode. Calculator selected in the Glass theme, with the settings window visible behind it.",
    "stills": [
      {
        "capture": "glass-light",
        "file": "glass-light.png",
        "caption": "The Glass theme in light mode. Nothing frosts the window behind the panel.",
        "alt": "Slick's search panel in the Glass theme, light mode, over the About page of Slick's settings window and a pale lavender wallpaper. The query “cal” lists Calendar, Calculator, Calculator History, Quit All Applications, Eject All Disks, Search Apple Maps and Create Quicklink, with Calculator selected. The glass has no tint and no frost, so the app icon, the name Slick, the version and the license and privacy lines show sharp through it. The panel's text carries a soft light halo. Captured from the assembled app running a scripted scenario, with Apple's own apps."
      }
    ]
  },
  "steps": [
    {
      "app": {
        "setFeatures": {
          "contacts": false,
          "schedule": false,
          "bookmarks": false,
          "ai": false,
          "snippets": false,
          "scripts": false,
          "menu-items": false
        },
        "setSettings": {
          "visibleRows": 7,
          "app.general.resetToRootAfter": 0,
          "themeName": "Glass"
        }
      }
    },
    {
      "app": {
        "theme": "Glass"
      }
    },
    {
      "summon": true
    },
    {
      "type": "mail"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Mail"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "calendar"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Calendar"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "music"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Music"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "notes"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Notes"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "app": {
        "openSettings": "about"
      }
    },
    {
      "record": {
        "name": "clip-glass-light",
        "appearance": "light",
        "lead": 0.3
      }
    },
    {
      "app": {
        "setSettings": {
          "visibleRows": 8
        }
      }
    },
    {
      "app": {
        "setSettings": {
          "visibleRows": 7
        }
      }
    },
    {
      "summon": true
    },
    {
      "waitUntilIdle": 2
    },
    {
      "expect": {
        "query": "",
        "rowsInclude": [
          "Mail",
          "Calendar",
          "Music",
          "Notes"
        ]
      }
    },
    {
      "wait": 0.5
    },
    {
      "wait": 0.3
    },
    {
      "type": "c"
    },
    {
      "wait": 0.3
    },
    {
      "type": "a"
    },
    {
      "wait": 0.3
    },
    {
      "type": "l"
    },
    {
      "waitUntilIdle": 2
    },
    {
      "expect": {
        "selection": "Calendar"
      }
    },
    {
      "wait": 0.6
    },
    {
      "app": {
        "select": "Calculator"
      }
    },
    {
      "expect": {
        "selection": "Calculator"
      }
    },
    {
      "wait": 0.5
    },
    {
      "still": "glass-light"
    },
    {
      "press": "cmd+k"
    },
    {
      "waitUntilIdle": 2
    },
    {
      "expect": {
        "actions": [
          "Open",
          "Show in Finder",
          "Show Package Contents",
          "Copy Name",
          "Copy Bundle Identifier",
          "Copy Path",
          "Add to Favorites",
          "Set Alias",
          "Set Hotkey",
          "Reset Ranking"
        ]
      }
    },
    {
      "wait": 1.0
    },
    {
      "press": "cmd+k"
    },
    {
      "waitUntilIdle": 2
    },
    {
      "expect": {
        "visible": true,
        "query": "cal",
        "selection": "Calculator"
      }
    },
    {
      "wait": 0.3
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "wait": 0.2
    },
    {
      "stopRecording": {
        "tail": 0.5,
        "poster": 5.3
      }
    },
    {
      "app": {
        "launched": [
          "com.apple.mail",
          "com.apple.iCal",
          "com.apple.Music",
          "com.apple.Notes",
          "com.apple.calculator"
        ]
      }
    },
    {
      "app": {
        "closeSettings": true
      }
    }
  ]
}
