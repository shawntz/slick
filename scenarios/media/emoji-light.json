{
  "name": "The emoji grid fills as a name is typed",
  "timeLimit": 110,
  "systemApps": true,
  "media": {
    "file": "clip-emoji-light",
    "appearance": "light",
    "caption": "Search emoji by name.",
    "alt": "Slick in light mode. Searching for “heart” filters the emoji grid to hearts. Arrow keys move the selection.",
    "gifAlt": "Slick in light mode. Searching for “heart” filters the emoji grid to hearts. Arrow keys move the selection.",
    "posterAlt": "Slick in light mode. An emoji grid filtered to hearts, with the selected emoji named below."
  },
  "steps": [
    {
      "app": {
        "setFeatures": {
          "contacts": false,
          "schedule": false,
          "bookmarks": false,
          "ai": false,
          "snippets": false,
          "scripts": false,
          "menu-items": false
        },
        "setSettings": {
          "visibleRows": 7,
          "app.general.resetToRootAfter": 0
        }
      }
    },
    {
      "summon": true
    },
    {
      "type": "mail"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Mail"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "calendar"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Calendar"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "music"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Music"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "query": "",
        "rowsInclude": [
          "Mail",
          "Calendar",
          "Music"
        ]
      }
    },
    {
      "record": {
        "name": "clip-emoji-light",
        "appearance": "light"
      }
    },
    {
      "wait": 0.2
    },
    {
      "type": "emoji"
    },
    {
      "expect": {
        "selection": "Search Emoji and Symbols"
      }
    },
    {
      "wait": 0.4
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "page": "grid"
      }
    },
    {
      "wait": 1.0
    },
    {
      "type": "heart"
    },
    {
      "waitUntilIdle": 2
    },
    {
      "wait": 0.6
    },
    {
      "press": "right"
    },
    {
      "press": "right"
    },
    {
      "wait": 0.5
    },
    {
      "press": "down"
    },
    {
      "wait": 1.2
    },
    {
      "stopRecording": {
        "tail": 0.3,
        "poster": 5.6
      }
    }
  ]
}
