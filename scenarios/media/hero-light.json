{
  "name": "The panel opens, two typed letters find the app, and Return opens it",
  "timeLimit": 110,
  "systemApps": true,
  "media": {
    "file": "hero-light",
    "appearance": "light",
    "caption": "Type “no” to find Notes. Press Return to open it.",
    "alt": "Slick in light mode. Typing “no” selects Notes and completes its name. Return closes the panel after a simulated app launch.",
    "gifAlt": "Slick in light mode. Typing “no” selects Notes and completes its name. Return closes the panel after a simulated app launch.",
    "posterAlt": "Slick in light mode. The search “no” selects Notes and completes its name."
  },
  "steps": [
    {
      "app": {
        "setFeatures": {
          "contacts": false,
          "schedule": false,
          "bookmarks": false,
          "ai": false,
          "snippets": false,
          "scripts": false,
          "menu-items": false
        },
        "setSettings": {
          "visibleRows": 7,
          "app.general.resetToRootAfter": 0
        }
      }
    },
    {
      "summon": true
    },
    {
      "type": "mail"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Mail"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "calendar"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Calendar"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "music"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Music"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "record": {
        "name": "hero-light",
        "appearance": "light",
        "lead": 0.3
      }
    },
    {
      "summon": true
    },
    {
      "waitUntilIdle": 2
    },
    {
      "expect": {
        "query": "",
        "rowsInclude": [
          "Mail",
          "Calendar",
          "Music"
        ]
      }
    },
    {
      "wait": 0.7
    },
    {
      "type": "n"
    },
    {
      "wait": 0.4
    },
    {
      "type": "o"
    },
    {
      "expect": {
        "selection": "Notes",
        "ghost": "tes"
      }
    },
    {
      "wait": 1.5
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "wait": 0.4
    },
    {
      "stopRecording": {
        "tail": 0.5,
        "poster": 2.8
      }
    },
    {
      "app": {
        "launched": [
          "com.apple.mail",
          "com.apple.iCal",
          "com.apple.Music",
          "com.apple.Notes"
        ]
      }
    }
  ]
}
