{
  "name": "Command-K opens the actions of the selected app, and typing filters them",
  "timeLimit": 110,
  "systemApps": true,
  "media": {
    "file": "actions-light",
    "appearance": "light",
    "caption": "Press Command-K to see actions. Type to filter them.",
    "alt": "Slick in light mode. Command-K opens the actions for Calendar. Typing “fav” finds Add to Favorites.",
    "gifAlt": "Slick in light mode. Command-K opens the actions for Calendar. Typing “fav” finds Add to Favorites.",
    "posterAlt": "Slick in light mode. The action panel for Calendar, with Open, Show in Finder and Add to Favorites."
  },
  "steps": [
    {
      "app": {
        "setFeatures": {
          "contacts": false,
          "schedule": false,
          "bookmarks": false,
          "ai": false,
          "snippets": false,
          "scripts": false,
          "menu-items": false
        },
        "setSettings": {
          "visibleRows": 7,
          "app.general.resetToRootAfter": 0
        }
      }
    },
    {
      "summon": true
    },
    {
      "type": "mail"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Mail"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "calendar"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Calendar"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "type": "music"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "app": {
        "select": "Music"
      }
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": false
      }
    },
    {
      "summon": true
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "query": "",
        "rowsInclude": [
          "Mail",
          "Calendar",
          "Music"
        ]
      }
    },
    {
      "record": {
        "name": "actions-light",
        "appearance": "light"
      }
    },
    {
      "wait": 0.2
    },
    {
      "type": "cal"
    },
    {
      "expect": {
        "selection": "Calendar"
      }
    },
    {
      "wait": 0.6
    },
    {
      "press": "cmd+k"
    },
    {
      "wait": 0.6
    },
    {
      "press": "down"
    },
    {
      "press": "down"
    },
    {
      "wait": 0.5
    },
    {
      "type": "fav"
    },
    {
      "waitUntilIdle": 2
    },
    {
      "wait": 0.8
    },
    {
      "press": "return"
    },
    {
      "waitUntilIdle": 3
    },
    {
      "expect": {
        "visible": true,
        "query": "cal"
      }
    },
    {
      "wait": 1.0
    },
    {
      "stopRecording": {
        "tail": 0.4,
        "poster": 4.2
      }
    },
    {
      "app": {
        "favorites": [
          "app:com.apple.iCal"
        ]
      }
    }
  ]
}
