{
  "name": "In a session a link opened, a command kept out of links is refused and a destructive question starts on Cancel",
  "timeLimit": 30,
  "steps": [
    { "app": { "link": "{scheme}://commands/snippets/import", "linkOutcome": "refused" } },
    { "app": { "link": "{scheme}://commands/quicklinks/import", "linkOutcome": "refused" } },
    { "expect": { "visible": false } },
    { "app": { "link": "{scheme}://search?q=import%20snippets", "linkOutcome": "openedLauncher" } },
    { "waitUntilIdle": 3 },
    { "expect": { "visible": true, "query": "import snippets", "selection": "" } },
    { "app": { "select": "Import Snippets" } },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": { "toast": "This Command Cannot Run from a Link: A link opened {brand} this time. Open it yourself, with its hotkey or from the menu bar, and run the command from there.", "page": "root" } },
    { "app": { "openDialogs": 0 } },
    { "dismiss": true },
    { "summon": true },
    { "expect": { "query": "", "visible": true } },
    { "type": "import snippets" },
    { "waitUntilIdle": 3 },
    { "app": { "select": "Import Snippets" } },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "app": { "openDialogs": 1 } },
    { "dismiss": true },
    { "app": { "link": "{scheme}://commands/system/shut-down", "linkOutcome": "asked" } },
    { "waitUntilIdle": 2 },
    { "app": { "select": "Run Shut Down" } },
    { "app": { "advanceClock": 1 } },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": { "card": "Shut Down Your Mac Now?" } },
    { "press": "return" },
    { "expect": { "card": "" } },
    { "app": { "launched": [], "opened": [] } }
  ]
}
