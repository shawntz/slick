{
  "name": "Window commands run on the simulated desktop",
  "timeLimit": 30,
  "steps": [
    { "summon": true },
    { "type": "switch windows" },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "page": "list", "rows": ["Draft", "Start Page", "Notes", "Inbox"] } },
    { "press": "cmd+k" },
    { "expect": { "actions": ["Switch to Window", "Minimize Window", "Close Window"] } },
    { "press": "cmd+k" },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "visible": false } },
    { "app": { "setSettings": { "windows.showsLayoutName": true } } },
    { "summon": true },
    { "press": "escape" },
    { "press": "escape" },
    { "type": "left half" },
    { "expect": { "selection": "Left Half" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "visible": false } },
    { "app": { "hud": "Left Half" } },
    { "summon": true },
    { "press": "escape" },
    { "type": "left half" },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "app": { "hud": "Left Two Thirds", "launched": [] } }
  ]
}
