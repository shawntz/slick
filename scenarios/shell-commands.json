{
  "name": "A command typed after > runs in the simulated shell and shows its output, and one typed after two spaces stays out of Shell History",
  "timeLimit": 40,
  "steps": [
    { "summon": true },
    { "type": ">  echo hidden words" },
    { "waitUntilIdle": 3 },
    { "expect": { "rows": ["echo hidden words"], "selection": "echo hidden words" } },
    { "app": { "selectedSubtitle": "Press Return to run it in your shell. It is not saved to history." } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "page": "detail", "title": "echo hidden words", "detailIncludes": "hidden words" } },
    { "app": { "detailMetadata": { "Status": "Exited with status 0" } } },
    { "press": "cmd+escape" },
    { "press": "escape" },
    { "expect": { "page": "root", "query": "" } },
    { "type": "shell history" },
    { "waitUntilIdle": 3 },
    { "app": { "select": "Shell History" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "page": "list", "title": "Shell History", "rowCount": 0 } },
    { "press": "cmd+escape" },
    { "press": "escape" },
    { "type": "> echo hello from the shell" },
    { "waitUntilIdle": 3 },
    { "expect": { "rows": ["echo hello from the shell"], "selection": "echo hello from the shell" } },
    { "app": { "selectedSubtitle": "Press Return to run it in your shell." } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "page": "detail", "title": "echo hello from the shell", "detailIncludes": "hello from the shell" } },
    { "app": { "detailMetadata": { "Status": "Exited with status 0", "Command": "echo hello from the shell" } } },
    { "press": "cmd+k" },
    { "expect": { "actions": ["Copy Output", "Paste Output", "Run Again", "Copy Command", "Open in Terminal"] } },
    { "press": "cmd+k" },
    { "press": "cmd+escape" },
    { "press": "escape" },
    { "type": "shell history" },
    { "waitUntilIdle": 3 },
    { "app": { "select": "Shell History" } },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "expect": { "page": "list", "title": "Shell History", "rows": ["echo hello from the shell"] } },
    { "app": { "launched": [], "opened": [] } },
    { "dismiss": true }
  ]
}
