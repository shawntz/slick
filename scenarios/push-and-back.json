{
  "name": "A command pushes its page and Escape and Delete go back",
  "timeLimit": 20,
  "steps": [
    { "summon": true },
    { "type": "running" },
    { "expect": { "selection": "Running Applications" } },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": { "page": "list", "title": "Running Applications", "rows": ["Mail", "Notes"], "selection": "Mail", "query": "" } },
    { "capture": { "name": "running", "key": true } },
    { "type": "no" },
    { "waitUntilIdle": 2 },
    { "expect": { "rows": ["Notes"], "selection": "Notes" } },
    { "press": "escape" },
    { "expect": { "page": "list", "query": "", "rows": ["Mail", "Notes"] } },
    { "press": "escape" },
    { "expect": { "page": "root", "query": "running", "selection": "Running Applications" } },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "expect": { "page": "list" } },
    { "press": "delete" },
    { "expect": { "page": "root", "visible": true } },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "app": { "select": "Notes" } },
    { "expect": { "selection": "Notes" } },
    { "press": "cmd+escape" },
    { "expect": { "page": "root" } }
  ]
}
