{
  "name": "An alias equal to another item's title wins that query",
  "timeLimit": 20,
  "steps": [
    { "summon": true },
    { "type": "calendar" },
    { "expect": { "selection": "Calendar" } },
    { "press": "cmd+k" },
    { "type": "set alias" },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "type": "notes" },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 2 },
    { "app": { "aliases": { "app:com.example.calendar": "notes" } } },
    { "press": "escape" },
    { "type": "notes" },
    { "expect": { "selection": "Calendar", "rowsInclude": ["Calendar", "Notes"] } },
    { "app": { "select": "Notes" } },
    { "expect": { "selection": "Notes" } },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "app": { "launched": ["com.example.notes"] } },
    { "summon": true },
    { "type": "notes" },
    { "expect": { "selection": "Calendar" } },
    { "waitUntilIdle": 3 },
    { "press": "return" },
    { "waitUntilIdle": 3 },
    { "app": { "launched": ["com.example.notes", "com.example.calendar"] } }
  ]
}
