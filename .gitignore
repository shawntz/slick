.DS_Store

# Build outputs
/build/
# make release writes the signed app, its zips and the cask here
/dist/
/core/target/
/Packages/*/.build/
/Packages/Features/*/.build/
.swiftpm/
# Python's bytecode, which a script that imports another writes beside it
__pycache__/
/Packages/CoreBridge/Artifacts/

# Generated by make xcode
/*.xcodeproj/

# Per-developer signing settings for the Xcode project
/support/Local.xcconfig

# Lab notes, kept locally and never published
/.research/
